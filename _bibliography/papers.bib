@article{varaltadiasbento2020jogos,
  bibtex_show  = {true},
  author       = {Varalta, Caio and Dias, Gabriel and Bento, Ronaldo Rodrigues},
  title        = {Jogos \& Aprendizado: Perspectivas de Jogador, Desenvolvedor e Educador},
  journal      = {Make the Game},
  preview      = {varaltadiasbento2020jogos.gif},
  entrysubtype = {magazine},
  abbr         = {MTG},
  number       = {26},
  pages        = {43--52},
  month        = {12},
  year         = {2020},
  abstract     = {Este artigo explora os impactos e o potencial dos jogos digitais na aprendizagem e na educa{\c{c}}{\~a}o a partir de tr{\^e}s perspectivas complementares: jogador, desenvolvedor e educador. Na perspectiva do jogador, abordam-se o aprendizado vis{\'\i}vel (conte{\'u}dos hist{\'o}ricos e culturais, como em Uncharted 3) e o aprendizado invis{\'\i}vel (gest{\~a}o de recursos, criatividade e pensamento estrat{\'e}gico em jogos como The Sims e Minecraft). Na perspectiva do desenvolvedor, discutem-se o game design, a psicologia das cores, a sonoriza{\c{c}}{\~a}o, a narrativa e a multidisciplinaridade exigida na cria{\c{c}}{\~a}o de jogos. Por fim, na perspectiva do educador, analisam-se os desafios da aprendizagem baseada em jogos, as diferen{\c{c}}as entre jogos de entretenimento e did{\'a}ticos, e apresenta-se o estudo de caso do jogo educativo Yuru Yuri - Perfect Math, desenvolvido no RPG Maker VX Ace.},
  pdf          = {https://archive.org/details/ed-26-01},
  website      = {https://condadobraveheart.com/Portal/Make_The_Game/MakeTheGame%2326.pdf},
  note         = {Condado Braveheart Editora},
  url          = {https://condadobraveheart.com/Portal/Make_The_Game/MakeTheGame%2326.pdf}
}

