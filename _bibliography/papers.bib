@article{varalta2015monomito,
  author       = {Caio Varalta},
  title        = {O Monomito e a Jornada de Link},
  journaltitle = {Make The RPG!},
  abbr         = {MTRPG},
  number       = {9},
  pages        = {20--23},
  year         = {2015},
  month        = {12},
  entrysubtype = {magazine}, 
  abstract     = {Este artigo introduz o conceito do Monomito (A Jornada do Herói) de Joseph Campbell e explora sua aplicação na estruturação narrativa de jogos eletrônicos. O trabalho sintetiza o ciclo narrativo em 11 etapas fundamentais — do estado cotidiano à resolução do conflito — e demonstra sua aplicação prática no desenvolvimento de jogos por meio de um estudo de caso focado em The Legend of Zelda: Ocarina of Time, mapeando a trajetória do protagonista Link ao longo da estrutura de Campbell.},
  preview      = {varalta2015monomito.png},
  pdf          = {https://archive.org/details/ed-09},
  website      = {https://condadobraveheart.com/Portal/Make_The_RPG/MRPG-ED09.pdf},
  note         = {Editora Braveheart},
  url          = {https://condadobraveheart.com/Portal/Make_The_RPG/MRPG-ED09.pdf}
}

@article{varalta2015olhos,
  bibtex_show  = {true},
  author       = {Caio Varalta},
  title        = {Os olhos do Desenvolvedor},
  journaltitle = {Make The RPG!},
  abbr         = {MTRPG},
  number       = {8},
  pages        = {18--19},
  year         = {2015},
  entrysubtype = {magazine},
  abstract     = {Este artigo introduz o conceito de "olhos de desenvolvedor", uma habilidade analítica passiva adquirida ao compreender a criação de jogos, e discute sua relação com o Game Design na construção de experiências marcantes. A matéria explora como a percepção crítica de mecânicas molda a experiência do jogador, ilustrando a sensação de progressão por meio das barreiras de ambiente na franquia Pokémon e a indução à rejogabilidade estratégica pelo sistema de obtenção da Zodiac Spear em Final Fantasy XII. Por fim, o texto enfatiza a importância de analisar e absorver a arte de títulos consolidados como fundamento prático para a modelagem de novos jogos.},
  preview      = {varalta2015olhos.png},
  pdf          = {https://archive.org/details/ed-08_202409},
  website      = {https://condadobraveheart.com/Portal/Make_The_RPG/MRPG-ED08.pdf},
  note         = {Editora Braveheart},
  url          = {https://condadobraveheart.com/Portal/Make_The_RPG/MRPG-ED08.pdf}
}

