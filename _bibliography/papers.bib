@inproceedings{almeidasantossilva2018exportacaojson,
  bibtex_show  = {true},
  author       = {Almeida, Caio C{\'e}sar Varalta Barreto de and Santos, Jos{\'e} Mateus dos and Silva, Luis Alexandre da},
  title        = {Exporta{\c{c}}{\~a}o de tabelas no formato {JSON} utilizando {Oracle} com recursos nativos},
  booktitle    = {Anais da {XIII} Jornada Cient{\'\i}fica das Faculdades Integradas de Bauru (FIB)},
  abbr         = {FIB},
  year         = {2018},
  month        = {12},
  issn         = {2358-6044},
  abstract     = {Este estudo investiga a viabilidade da exporta{\c{c}}{\~a}o de dados de bancos relacionais para o formato JSON utilizando exclusivamente recursos nativos em PL/SQL no SGBD Oracle Database 12c. O experimento avaliou a extra{\c{c}}{\~a}o de uma base sint{\'e}tica contendo 25.717 registros divididos em quatro tabelas sobre dados ol{\'\i}mpicos, empregando as fun{\c{c}}{\~o}es nativas json\_object e o pacote UTL\_FILE. Os resultados confirmam a integridade do processo e a leveza dos arquivos gerados (totalizando menos de 2,5 MB). Contudo, o trabalho aponta limita{\c{c}}{\~o}es t{\'e}cnicas da vers{\~a}o 12c relativas {\`a} fun{\c{c}}{\~a}o json\_arrayagg no agrupamento de um modelo {\'u}nico com retornos em CLOB ou codifica{\c{c}}{\~a}o UTF-8, concluindo pela viabilidade da abordagem para exporta{\c{c}}{\~o}es tabulares com as devidas ressalvas de vers{\~a}o.},
  organization = {Faculdades Integradas de Bauru (FIB)},
  address      = {Bauru, SP, Brasil},
  preview      = {almeidasantossilva2018exportacaojson.png},
  note         = {Grupo de trabalho: Ci{\^e}ncia da Computa{\c{c}}{\~a}o},
  pdf          = {https://fibbauru.br/uploads/561/Anais_Computacao.pdf},
  url          = {https://fibbauru.br/uploads/561/Anais_Computacao.pdf}
}

@techreport{almeidasantossilva2018exportacao,
  bibtex_show = {true},
  author      = {Almeida, Caio C{\'e}sar Varalta Barreto de and Santos, Jos{\'e} Mateus dos and Silva, Luis Alexandre da},
  title       = {Exporta{\c{c}}{\~a}o e importa{\c{c}}{\~a}o de dados entre bancos de dados {Oracle} e {MySQL} utilizando o formato {JSON} para trafegar os dados},
  abstract    = {The usage of two or more different databases is very common in organizational environments. Aiming at this scenario, the present paper has the objective to explore a simple way to transpose data between an Oracle database and a MySQL database. Native resources of both databases were exploited to work with JSON format files, an easy-to-manipulate text format, which can be exported and imported into the databases used. Based on the results obtained, was confirmed the viability of the to export the tables from an Oracle relational model database to a MySQL relational model using .JSON format files.},
  institution = {Faculdade de Tecnologia de Bauru (FATEC Bauru)},
  type        = {Trabalho de Conclus{\~a}o de Curso (Tecnologia em Banco de Dados)},
  abbr        = {FATEC},
