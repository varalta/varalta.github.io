@misc{varalta2025automacao,
  bibtex_show   = {true},
  author        = {Varalta, Caio and Pereira, Leonardo Tortoro},
  title         = {Automação de Playtesting Baseada em Personas: Uma Revisão Concisa da Literatura},
  year          = {2025},
  publisher     = {Zenodo},
  doi           = {10.5281/zenodo.17502912},
  url           = {https://doi.org/10.5281/zenodo.17502912},
  abbr          = {Zenodo},
  abstract      = {O interesse acadêmico por automação de testes em videogames está em ascensão, porém persiste uma lacuna entre as soluções propostas e as demandas industriais. Este estudo apresenta uma revisão concisa da literatura sobre playtesting automatizado baseado em personas, destacando os principais métodos, ambientes e estratégias de validação empregadas. Observa-se a predominância de jogos 2D e a ênfase em validações quantitativas por meio de métricas de jogabilidade. As principais lacunas são a escassez de ambientes mais complexos e a ausência de avaliações qualitativas com profissionais da indústria.}
  note          = {Presented at the XIV Workshop do Programa de Pós-Graduação em Ciência da Computação da Unesp.}
}

@misc{varalta2024refindself,
  bibtex_show  = {true},
  author       = {Varalta, Caio},
  title        = {Análise do sistema de personalidades em {Refind Self}},
  type         = {Slide presentation},
  month        = {08},
  year         = {2024},
  publisher    = {Zenodo},
  doi          = {10.5281/zenodo.13372625},
  url          = {https://doi.org/10.5281/zenodo.13372625},
  abbr         = {Zenodo},
  abstract     = {Esta apresentação oferece uma análise preliminar do sistema de personalidades implementado no jogo indie Refind Self: The Personality Test Game, desenvolvido pela Lizardry e publicado pela Playism em 2023. O trabalho descreve o funcionamento do sistema, levanta hipóteses sobre algumas das suas funcionalidades, e discute o seu potencial como inspiração para sistemas de inferência de perfil de jogador em futuras produções. A análise é informal e foi realizada de forma independente durante o meu primeiro semestre como aluno especial de Mestrado em Ciência da Computação. O texto alerta explicitamente contra a interpretação do jogo como ferramenta clínica de psicologia.},
  website      = {https://condadobraveheart.com/threads/analise-do-sistema-de-personalidades-em-refind-self.8229/},
  slides       = {https://www.slideshare.net/slideshow/analise-do-sistema-de-personalidades-em-refind-self/271304421},
  dimensions   = {true},
  preview      = {https://archive.org/download/varalta2024refindself/varalta2024refindself.jpg}
}

